# ── ClickUp ───────────────────────────────────────────────────────────────────
# Your ClickUp webhook secret (set when registering the webhook)
CLICKUP_WEBHOOK_SECRET=your_clickup_webhook_secret_here

# The ClickUp Folder ID you want to watch (Tasks in this folder trigger quotes)
# Find it in the URL when you open the folder: app.clickup.com/.../<FOLDER_ID>/...
CLICKUP_FOLDER_ID=your_folder_id_here

# ── Xero ──────────────────────────────────────────────────────────────────────
# From your Xero Developer app (https://developer.xero.com/app/manage)
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here

# Your Xero organisation's tenant ID (returned when you complete OAuth)
# See SETUP.md for how to get this
XERO_TENANT_ID=your_xero_tenant_id_here

# Your initial Xero refresh token (generated during OAuth — see SETUP.md)
XERO_REFRESH_TOKEN=your_xero_refresh_token_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
